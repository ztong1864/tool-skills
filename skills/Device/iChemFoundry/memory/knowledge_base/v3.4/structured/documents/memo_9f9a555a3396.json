  "key_insights": [
    {
      "title": "Measurement",
      "body": "dynamic_uptake_C3H6 (C3H6) = 30.0 wt% at 1.0 bar"
    },
    {
      "title": "Measurement",
      "body": "thermal_decomposition_temperature = 340.0 K at 1.013 bar"
    },
