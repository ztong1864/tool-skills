  "one_line_summary": "CP-4 shows thermal_stability_limit = 159.0 K for target gas",
  "key_insights": [
    {
      "title": "Measurement",
      "body": "water_stability_duration_before_collapse (H2O) = 2.0 dimensionless at 1.013 bar"
    },
    {
      "title": "Measurement",
      "body": "thermal_stability_limit = 159.0 K at 1.013 bar"
    },
    {
      "title": "Measurement",
      "body": "pH_stability_min = 2.0 dimensionless at 1.013 bar"
    },
    {
      "title": "Mechanism",
      "body": "anion coordination ability and steric hindrance → stability"
    },
    {
      "title": "Mechanism",
      "body": "formation_of_AgCl_phase_after_Ag_I_adsorption → stability"
    },
    {
      "title": "Design Rule",
      "body": "[positive] anchor a high density of chlorine (-Cl) functionalities in the framework → improves Ag+ interaction, detection, and adsorption capacity"
    },
    {
      "title": "Design Rule",
      "body": "[positive] regulate anions during self-assembly to introduce anion-derived functional groups into Zn(II) coordination polymers → produces varying structures and enables multifunctional performance tuning"
    },
    {
      "title": "Comparison",
      "body": "compound 4 vs previously reported sensing adsorbent materials: winner=subject_a on combined sensing selectivity, sensing sensitivity, and adsorption capacity"
    }
  ],
