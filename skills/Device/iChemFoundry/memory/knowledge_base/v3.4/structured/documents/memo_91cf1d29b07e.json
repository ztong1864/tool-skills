  "one_line_summary": "5′ shows thermal_stability_limit = 600.0 K for target gas",
  "key_insights": [
    {
      "title": "Measurement",
      "body": "thermal_stability_limit = 600.0 K at 1.013 bar"
    },
    {
      "title": "Mechanism",
      "body": "three-dimensional cadmium sulfate substructure {Cd8(SO4)5}n6n+ → stability"
    },
    {
      "title": "Mechanism",
      "body": "outward-projecting triazolate groups with 60° angle between alternate ring planes → stability"
    },
    {
      "title": "Design Rule",
      "body": "[positive] combine tridentate triazolate bridges with anionic components capable of bridging modes → gives complex connectivity patterns, higher-dimensional materials, and remarkable structural diversity"
    },
    {
      "title": "Design Rule",
      "body": "[positive] include charge-balancing anions together with triazolate when designing M(II)/triazolate frameworks → produces the general material class M(II)/triazolate/Xn- across halide, hydroxide, nitrate, and sulfate systems"
    },
    {
      "title": "Comparison",
      "body": "[Cd2(trz)3I] (8) vs [Zn2(trz)3(OH)] (3): winner=subject_a on unit_cell_volume_relative_change_percent"
    },
    {
      "title": "Comparison",
      "body": "[Zn(trz)Br] (2) vs the remainder of the compounds in this study: winner=subject_b on framework_dimensionality"
    },
    {
      "title": "Failure",
      "body": "[performance_regression] synthesize Zn/trz/NO3- phases under varied conditions: no conditions were found that provided Zn/trz/NO3- phases"
    }
  ],
