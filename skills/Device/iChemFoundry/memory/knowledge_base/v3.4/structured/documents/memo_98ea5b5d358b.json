  ],
  "one_line_summary": "ZSTU-32 shows ethylene_purification_enhancement_factor = 17.0 dimensionless for C2H4",
  "key_insights": [
    {
      "title": "Measurement",
      "body": "ethylene_purification_enhancement_factor (C2H4) = 17.0 dimensionless"
    },
    {
      "title": "Mechanism",
      "body": "dynamic_triazolate_linker_rotation_and_reversible_Zn-O_bond_rearrangement → uptake"
    },
    {
      "title": "Mechanism",
      "body": "rigid framework relative to Zn2(daTz)2SO4 → stability"
    },
    {
      "title": "Design Rule",
      "body": "[positive] incorporate asymmetric, non-amino-functionalized linkers such as mTz → suppresses framework flexibility, locks the structure, and enhances selectivity for CO2 over light hydrocarbons"
    },
    {
      "title": "Design Rule",
      "body": "[positive] apply a multivariate functionality (MTV) strategy to modulate framework flexibility in sulfate-pillared MAFs → enables efficient CO2/C2 separation by suppressing non-target-gas-triggered structural transformations while maintaining a favorable pore microenvironment"
    },
    {
      "title": "Comparison",
      "body": "MTV crystals containing symmetric Tz or amino-functionalized aTz vs MTV crystals containing mTz: winner=subject_b on flexibility_under_ethane_exposure"
    },
    {
      "title": "Comparison",
      "body": "Zn2(mTz)0.74(daTz)1.26SO4 vs Zn2(daTz)2SO4: winner=subject_a on framework_rigidity_under_guest_or_activation_perturbation"
    },
    {
      "title": "Failure",
      "body": "[performance_regression] use Zn2(daTz)2SO4 as a flexible adsorbent under CO2 or C2H6 loading: Zn2(daTz)2SO4 undergoes structural transformation upon CO2 or C2H6 adsorption, compromising CO2/C2H4 and CO2/C2H6 selectivity"
    }
  ],
