  "key_insights": [
    {
      "title": "Measurement",
      "body": "delta_q_C3H6/C2H4 (C3H6) = 6.17 mmol/g at 1.013 bar"
    },
    {
      "title": "Measurement",
      "body": "weight_loss (DMF/H2O) = 29.8 wt% at 1.013 bar"
    },
    {
      "title": "Measurement",
      "body": "IAST_selectivity_C3H6/C2H4 (C3H6) = 10.5 dimensionless at 1.0 bar"
    },
    {
      "title": "Mechanism",
      "body": "more abundant framework interactions for C3H6 → selectivity"
    },
    {
      "title": "Mechanism",
      "body": "functionalized pore surface with accessible N/O atoms and exposed metal sites → selectivity"
    },
    {
      "title": "Design Rule",
      "body": "[positive] avoid relying solely on narrow-pore size-sieving for separation → can prevent adsorption amount from being limited"
    },
    {
      "title": "Design Rule",
      "body": "[positive] combine open metal sites with accessible organic hydrogen-bond-acceptor sites in a MOF for C2H4/C3H6 separation → improves preferential adsorption of C3H6 over C2H4 and helps address the capacity-selectivity trade-off"
    },
    {
      "title": "Comparison",
      "body": "Mn-dtzip vs spe-MOF: winner=subject_a on high-purity_C2H4_collection_capacity"
    }
  ],
