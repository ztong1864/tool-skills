  "target_molecules": [
    "N2"
  ],
  "one_line_summary": "{[Zn(Htrz)(Hbtc)(H2O)]-2H2O}n shows lattice_water_removal_end_temperature = 383.15 K for H2O",
  "key_insights": [
    {
      "title": "Measurement",
      "body": "coordinated_water_loss (H2O) = 5.7 wt% at 1.013 bar"
    },
    {
      "title": "Measurement",
      "body": "lattice_water_weight_loss (H2O) = 8.5 wt% at 1.013 bar"
    },
    {
      "title": "Measurement",
      "body": "lattice_water_removal_onset_temperature (H2O) = 333.15 K at 1.013 bar"
    },
    {
      "title": "Mechanism",
      "body": "1D_infinite_chain_bridged_by_Hbtc → stability"
    },
    {
      "title": "Mechanism",
      "body": "incomplete_deprotonation_of_Htrz_and_Hbtc → stability"
    },
    {
      "title": "Design Rule",
      "body": "[positive] use fully deprotonated ligands to assemble Zn/trz/btc secondary building units → enables formation of an 8-connected trinodal 3,8-connected 3-D network rather than lower-dimensional assembly"
    },
    {
      "title": "Design Rule",
      "body": "[negative] avoid incomplete deprotonation of both ligands in Zn/trz/btc assembly → lowers dimensionality to complex 3 and shifts consolidation toward weak hydrogen-bond interactions"
    },
    {
      "title": "Comparison",
      "body": "complex 1 vs complexes 2 and 3: winner=tie on thermal_stability"
    }
  ],
