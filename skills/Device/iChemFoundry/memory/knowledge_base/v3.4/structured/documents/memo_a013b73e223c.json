  "one_line_summary": "Zn-mfa-atz-pcu shows thermal_stability = 380.0 K for target gas",
  "key_insights": [
    {
      "title": "Measurement",
      "body": "IAST_selectivity_CO2/C2H4 (CO2) = 1.6 dimensionless at 1.0 bar"
    },
    {
