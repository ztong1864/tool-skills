  "one_line_summary": "MIL-120(Al)-HP shows BET_surface_area = 590.0 m2/g for N2",
  "key_insights": [
    {
      "title": "Measurement",
      "body": "thermal_stability_limit = 400.0 K at 1.013 bar"
    },
    {
      "title": "Measurement",
      "body": "CO2_induced_phase_change_pressure_lower_bound (CO2) = 0.3 bar at 0.3 bar"
    },
    {
      "title": "Measurement",
      "body": "CO2_induced_phase_change_pressure_upper_bound (CO2) = 0.4 bar at 0.4 bar"
    },
    {
      "title": "Mechanism",
      "body": "no_phase_transition_under_dynamic_vacuum → stability"
    },
    {
      "title": "Mechanism",
      "body": "dense_mu2-OH_groups_in_channels → uptake"
    },
    {
      "title": "Design Rule",
      "body": "[positive] design Al-MOFs with a high metal-to-ligand ratio using cheap commercial polycarboxylic acids and inexpensive Al sources → higher Al/L ratio is linked to enhanced chemical and thermal stability and relatively lower production cost, making such Al-MOFs promising for CO2 capture when performance is comparable to CALF-20"
    },
    {
      "title": "Design Rule",
      "body": "[positive] increase the density and accessibility of µ2-OH groups in MIL-120(Al)-type channels → denser hydroxyl polar groups are identified as beneficial for enhanced CO2 interactions and are expected to produce a very steep low-pressure adsorption isotherm"
    },
    {
      "title": "Comparison",
      "body": "MIL-120(Al)-AP vs other MOFs: winner=subject_a on metal_to_ligand_ratio"
    }
  ],
