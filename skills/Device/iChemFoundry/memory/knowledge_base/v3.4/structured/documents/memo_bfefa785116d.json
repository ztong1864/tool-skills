  "one_line_summary": "Zn-trz-ox shows nitrobenzene_detection_limit = 400.0 dimensionless for nitrobenzene",
  "key_insights": [
    {
      "title": "Measurement",
      "body": "nitrobenzene_detection_limit (nitrobenzene) = 400.0 dimensionless at 1.013 bar"
    },
    {
      "title": "Mechanism",
      "body": "Zn3(trz)6 cluster → selectivity"
    },
    {
      "title": "Mechanism",
      "body": "in situ generated dimethylammonium from DMF decomposition → stability"
    },
    {
      "title": "Design Rule",
      "body": "[positive] use DMF as the solvent/guest-controlling agent during synthesis → expected to obtain a coordination polymer material with larger pores because DMF controls porous size"
    },
    {
      "title": "Design Rule",
      "body": "[positive] use oxalate molecules as pillar linkers to connect 2-D Zn-triazolate layers → formation of a 3-D network from 2-D layers"
    },
    {
      "title": "Comparison",
      "body": "compound 1 vs some reported coordination polymer materials: winner=tie on sensing ability"
    },
    {
      "title": "Comparison",
      "body": "compound 1 vs reported compound [Zn2(ox)(trz)2]: winner=tie on 3-D backbone structure"
    },
    {
      "title": "Failure",
      "body": "[performance_regression] omit phthalic acid and N2H4 from the reaction precursors: the title compound 1 was not obtained"
    }
  ],
