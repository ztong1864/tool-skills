  "one_line_summary": "MAC-18 shows accessible_surface_area = 1427.54 m2/g for target gas",
  "key_insights": [
    {
      "title": "Measurement",
      "body": "accessible_surface_area = 1427.54 m2/g"
    },
    {
      "title": "Mechanism",
      "body": "single-step transformation behavior upon TEA injection → stability"
    },
    {
      "title": "Mechanism",
      "body": "1D hinge-like zig-zag chain and tritopic ligand with regulated hinge angle and hydrogen-bond interaction → stability"
    },
    {
      "title": "Design Rule",
      "body": "[positive] select tritopic ligands that serve as motion-converters and also account for their effect on structural transformation → improves the likelihood of effective pore-shape transformation"
    },
    {
      "title": "Design Rule",
      "body": "[positive] use hinge-like motion of the coordination node as a core architectural feature → is essential for achieving precise step control of pore-shape change needed for two-step size-exclusive adsorption"
    },
    {
      "title": "Comparison",
      "body": "MAC-20 vs earlier multi-step flexible MOFs including HMOF-1, [Zn(L)2(OH)2], and MCF-82: winner=subject_a on significant pore-shape change capability"
    },
    {
      "title": "Comparison",
      "body": "MAC-20 vs MAC-17: winner=subject_a on ease of retaining crystallinity upon heating"
    },
    {
      "title": "Failure",
      "body": "[performance_regression] use earlier multi-step flexible MOFs with weakly correlated hinge-chain motion for sequential adsorption: stepwise-controlled pore-shape change for sequential adsorption could not be executed"
    }
  ],
