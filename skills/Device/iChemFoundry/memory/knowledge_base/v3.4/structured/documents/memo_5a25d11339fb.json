  "one_line_summary": "Design rule: use azide-free reactants to synthesize azide-containing Zn-MOFs",
  "key_insights": [
    {
      "title": "Design Rule",
      "body": "[positive] use azide-free reactants to synthesize azide-containing Zn-MOFs → provides a straightforward and safer synthesis route"
    },
    {
      "title": "Design Rule",
      "body": "[positive] increase nitrogen content in energetic metal-organic frameworks → higher energetic performance and more nitrogen gas rather than residual carbon in combustion products"
    },
    {
      "title": "Comparison",
      "body": "[Zn2(atz)3(N3)]n vs RDX: winner=subject_a on heat_of_detonation"
    },
    {
      "title": "Comparison",
      "body": "[Zn2(atz)3(N3)]n vs many azide-containing energetic metal-organic frameworks: winner=subject_a on sensitivity"
    },
    {
      "title": "Failure",
      "body": "[performance_regression] synthesize energetic metal-organic frameworks using elaborate ligand design and complicated ligand synthesis: the preparation becomes uneconomical and tedious"
    }
  ],
