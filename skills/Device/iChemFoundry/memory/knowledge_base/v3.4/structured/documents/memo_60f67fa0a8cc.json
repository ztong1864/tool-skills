    {
      "title": "Mechanism",
      "body": "flexible_dicarboxylate_ligand_pda_enables_3D_entangled_architecture → stability"
    },
    {
      "title": "Mechanism",
      "body": "spacer length and flexibility of the carboxylate ligands → unknown"
    },
    {
      "title": "Design Rule",
      "body": "[positive] control the number of carboxylate groups, spacer length, and ligand flexibility of polycarboxylate ligands → resulting framework structures are significantly altered during coordination polymer construction"
    },
    {
      "title": "Design Rule",
      "body": "[positive] carefully control auxiliary ligands during synthesis → enables rational design and synthesis of new entangled MOFs"
    },
    {
      "title": "Comparison",
      "body": "complex 1 with bia ligand vs complex 2 with H2tpa ligand: winner=subject_b on framework_dimensionality"
    }
