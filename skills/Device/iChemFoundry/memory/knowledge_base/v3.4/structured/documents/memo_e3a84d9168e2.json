  "one_line_summary": "Design rule: operate CALF-20 at moderate CO2 partial pressure when regeneration is driven by water intrusion",
  "key_insights": [
    {
      "title": "Mechanism",
      "body": "strong guest confinement in angstropores → diffusion"
    },
    {
      "title": "Mechanism",
      "body": "1,2,4-triazolate-bridged Zn(II) layers pillared by oxalate forming a 3D lattice with 0.6-0.7 nm pores → porosity"
    },
    {
      "title": "Design Rule",
      "body": "[positive] operate CALF-20 at moderate CO2 partial pressure when regeneration is driven by water intrusion → more efficient desorption is suggested during regeneration"
    },
    {
      "title": "Comparison",
      "body": "CO2 vs H2O: winner=subject_a on adsorption_preference_in_CALF-20"
    },
    {
      "title": "Comparison",
      "body": "flexible CALF-20 framework vs rigid CALF-20 framework: winner=subject_a on CO2_diffusion_coefficient"
    },
    {
      "title": "Failure",
      "body": "[performance_regression] use water-wire formation in CALF-20 to promote higher CO2 adsorption: CO2 adsorption does not increase in CALF-20"
    }
  ],
