  "one_line_summary": "[Zn(AmTAZ)(CH3COO)] shows formation_temperature_range = 500.0 K for target gas",
  "key_insights": [
    {
      "title": "Measurement",
      "body": "formation_temperature_range = 500.0 K at 1.013 bar"
    },
    {
      "title": "Measurement",
      "body": "guest_weight_loss (guest_molecules) = 12.0 wt% at 1.013 bar"
    },
    {
      "title": "Measurement",
      "body": "product_weight_fraction = 43.0 wt% at 1.013 bar"
    },
    {
      "title": "Mechanism",
      "body": "nonintersecting channels → porosity"
    },
    {
      "title": "Mechanism",
      "body": "open-ended hollow nanotubular channels formed by Zn6F6(AmTAZ)6 rings → porosity"
    },
    {
      "title": "Design Rule",
      "body": "[positive] vary solvent medium, concentration, temperature, heating or cooling rate, Zn2+ and F- sources, reaction time, and ethanol-to-water ratio to tune crystallization → crystal morphology, particle size, crystal size, and guest identity can be controlled; larger crystals are most readily obtained from AmTAZ at high ethanol-to-water ratio, lower reagent concentration, and longer reaction time"
    },
    {
      "title": "Design Rule",
      "body": "[positive] use long rigid linkers, multifunctional bulky ligands, or large secondary building blocks to increase framework openness and prevent interpenetration → larger spacing between vertices and reduced interpenetration are enabled"
    },
    {
      "title": "Comparison",
      "body": "ZnF(AmTAZ) framework vs some high-porosity MOFs constructed using long linkers or large SBUs: winner=subject_b on solvent_accessible_volume"
    }
  ],
