  "one_line_summary": "BUT-25 shows thermal_stability = 310.0 K for target gas",
  "key_insights": [
    {
      "title": "Measurement",
      "body": "thermal_stability = 310.0 K at 1.013 bar"
    },
    {
      "title": "Mechanism",
      "body": "formate pillars in pillared-layer structure → stability"
    },
    {
      "title": "Mechanism",
      "body": "spectral_overlap_enabling_forster_energy_transfer → selectivity"
    },
    {
      "title": "Design Rule",
      "body": "[positive] replace oxygen anions with imidazole linkers having two N–Zn bonds at a similar angle → produces a series of zeolite-type MOFs known as ZIFs"
    },
    {
      "title": "Design Rule",
      "body": "[positive] tune the steric index of imidazolate linkers → allows synthesis of ZIFs with various pore sizes and topologies"
    },
    {
      "title": "Comparison",
      "body": "BUT-27 detection limits for Fe3+ and Cr2O7 2− vs US-EPA minimum values for Fe3+ and Cr2O7 2− in drinking water: winner=subject_a on detection_limit"
    },
    {
      "title": "Comparison",
      "body": "BUT-27 vs BUT-26: winner=subject_a on framework outcome after linker insertion into BUT-25"
    },
    {
      "title": "Failure",
      "body": "[performance_regression] use one-pot synthesis to obtain mixed-linker zeolitic MOFs combining multiple linkers such as carboxylate and imidazolate: mixed-linker zeolitic MOFs are rarely obtained"
    }
  ],
