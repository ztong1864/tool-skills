  "one_line_summary": "ZSTU-32 shows CO2_uptake = 128.5 cm3/g for CO2",
  "key_insights": [
    {
      "title": "Measurement",
      "body": "C2H4_purity (C2H4) = 98.2 wt% at 1.013 bar"
    },
    {
      "title": "Measurement",
      "body": "uptake_CO2 (CO2) = 67.0 cm3/g at 1.0 bar"
    },
    {
      "title": "Measurement",
      "body": "uptake_ratio_CO2/C2H4 (CO2) = 2.27 dimensionless at 0.1 bar"
    },
    {
      "title": "Mechanism",
      "body": "modulated_hydrogen_bonding_and_multiple_interlocking_sites → selectivity"
    },
    {
      "title": "Mechanism",
      "body": "gradient pore environment with narrow methyl-containing channel and 1D channel → selectivity"
    },
    {
      "title": "Design Rule",
      "body": "[positive] design a pore window of 6.5 x 4.7 A^2 with interconnected channels and central cavities through suitable hydrogen bonding → provides an optimal pore window for gas adsorption in ZSTU-30"
    },
    {
      "title": "Design Rule",
      "body": "[positive] use triazole-based ligands with tunable methyl and amino substituents → enables precise control over pore apertures and introduction of suitable binding sites for targeted separations"
    },
    {
      "title": "Comparison",
      "body": "ZSTU-30 vs Qc-5-Cu: winner=subject_b on CO2/C2H4_IAST_selectivity"
    }
  ],
