  "one_line_summary": "[Zn2(dmtrz)2(btec)(H2O)2] shows decomposition_temperature = 530.0 K for target gas",
  "key_insights": [
    {
      "title": "Measurement",
      "body": "decomposition_temperature = 530.0 K at 1.013 bar"
    },
    {
      "title": "Mechanism",
      "body": "guest-free dense 3D framework → stability"
    },
    {
      "title": "Mechanism",
      "body": "2D layer framework built from dinuclear [Zn2(dmtrz)2(H2O)] subunits and btec anions → stability"
    },
    {
      "title": "Design Rule",
      "body": "[positive] introduce aromatic carboxylate coligands into trz-based metal complexes via hydrothermal synthesis → produces a series of novel 3D topological frameworks unexpectedly"
    },
    {
      "title": "Design Rule",
      "body": "[positive] choose or design a suitable ligand → is described as the most important strategy for constructing MOFs with targeted structures and properties"
    },
    {
      "title": "Failure",
      "body": "[performance_regression] prepare trz-based complexes with aromatic acid as coligand: only limited trz-based complexes with aromatic acid as coligand have been reported"
    }
  ],
