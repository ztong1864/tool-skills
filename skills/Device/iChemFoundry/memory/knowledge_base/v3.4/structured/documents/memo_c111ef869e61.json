  "one_line_summary": "BUT-25 shows thermal_decomposition_onset = 310.0 K for target gas",
  "key_insights": [
    {
      "title": "Measurement",
      "body": "thermal_decomposition_onset = 310.0 K at 1.013 bar"
    },
    {
      "title": "Mechanism",
      "body": "formate pillars connecting honeycomb layers → stability"
    },
    {
      "title": "Mechanism",
      "body": "excitation-light absorption overlap → selectivity"
    },
    {
      "title": "Design Rule",
      "body": "[positive] use imidazolate linkers to build MOFs with zeolite topology → enables formation of zeolite-type MOFs"
    },
    {
      "title": "Design Rule",
      "body": "[positive] introduce a dicarboxylate linker with a 120° angle such as isophthalate in post-synthetic linker exchange of BUT-25 → enables successful structural transformation to a new zeolite-type framework"
    },
    {
      "title": "Comparison",
      "body": "BUT-26 vs BUT-27: winner=tie on Zn coordination environment"
    },
    {
      "title": "Comparison",
      "body": "BUT-26 formed from BUT-25 using H2TDC linker with 148° angle vs BUT-27 formed from BUT-25 using H2IPA linker with 120° angle: winner=tie on structural outcome after linker exchange"
    },
    {
      "title": "Failure",
      "body": "[performance_regression] add H2IPA linker with a 120° angle to BUT-25 while aiming to form a pillared-layer structure: the linker partially replaces the ATZ linker instead of preserving a pillared-layer motif"
    }
  ],
