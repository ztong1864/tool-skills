  "key_insights": [
    {
      "title": "Measurement",
      "body": "Qst_CO2 (CO2) = 39.5 K at 1.013 bar"
    },
    {
      "title": "Measurement",
      "body": "BET_surface_area (N2) = 51.6 m2/g at 1.013 bar"
