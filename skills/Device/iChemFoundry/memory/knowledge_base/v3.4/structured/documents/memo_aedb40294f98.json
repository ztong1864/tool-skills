    {
      "title": "Mechanism",
      "body": "size_sieving_throat → selectivity"
    },
    {
      "title": "Mechanism",
      "body": "Atz_binding_site → selectivity"
    },
    {
      "title": "Design Rule",
      "body": "[positive] use a local shrinkage throat with hanging molecular pocket architecture → enables complete molecular sieving for C3H6/C3H8 while achieving strong C3H6 adsorption and overcoming the usual capacity-kinetics trade-off"
    },
    {
      "title": "Design Rule",
      "body": "[negative] avoid relying solely on narrow sieving channels → larger molecules can be excluded, but diffusion is limited and adsorption capacity of the smaller target molecule is sacrificed"
    },
    {
      "title": "Comparison",
      "body": "HAF-1 vs ZU-609: winner=subject_a on uptake_ratio"
    }
