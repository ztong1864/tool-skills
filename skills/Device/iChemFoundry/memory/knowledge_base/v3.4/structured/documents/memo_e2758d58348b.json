  "one_line_summary": "Design rule: use a wall-trapped C2H2 tetramer arrangement in the MOF",
  "key_insights": [
    {
      "title": "Design Rule",
      "body": "[positive] use a wall-trapped C2H2 tetramer arrangement in the MOF → can effectively promote kinetic behavior through an available diffusion channel"
    },
    {
      "title": "Design Rule",
      "body": "[positive] promote surface-wall adsorption of C2H2 rather than channel-center adsorption in the MOF → diffusion process is expected to be further improved by keeping enough channel space available"
    },
    {
      "title": "Comparison",
      "body": "SNNU-98-Mn vs MOF 1: winner=subject_a on initial Qst for C2H2 (kJ mol−1)"
    },
    {
      "title": "Comparison",
      "body": "MOF 1 vs MOF-303: winner=subject_a on reported performance metric in 2023 comparison"
    },
    {
      "title": "Failure",
      "body": "[performance_regression] use IAST as the evaluation method in systems with narrow pores or structural flexibility: IAST results may contain errors or uncertainty"
    }
  ],
