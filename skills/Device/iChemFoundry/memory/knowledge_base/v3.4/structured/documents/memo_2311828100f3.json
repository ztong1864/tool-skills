    {
      "title": "Design Rule",
      "body": "[positive] increase aromaticity of ligand pillars in isomorphic Zn-triazolate-dicarboxylate pillar-layered MOFs → separation behavior shifts from C2H2-selective to CO2-selective inverse C2H2/CO2 separation, culminating in complete inverse separation for the highest-aromaticity Zn-BDC-TRZ"
    },
    {
      "title": "Design Rule",
      "body": "[neutral] use a shorter FA linker with one double bond → the change induces an intersection point between C2H2 and CO2 isothermal adsorption curves and only partial inversion rather than complete inverse separation"
    },
    {
      "title": "Comparison",
      "body": "Zn-BDC-TRZ vs Zn-MUC-TRZ: winner=subject_a on structural_robustness"
    }
