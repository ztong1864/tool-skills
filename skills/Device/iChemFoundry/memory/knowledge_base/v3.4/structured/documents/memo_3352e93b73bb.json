  "key_insights": [
    {
      "title": "Measurement",
      "body": "equilibrium_adsorption_capacity_phosphate (phosphate) = 212.23 mg/g at 1.013 bar"
    },
    {
      "title": "Measurement",
      "body": "remaining_concentration_phosphate (phosphate) = 0.102 mg/L at 1.013 bar"
    },
    {
      "title": "Measurement",
      "body": "decomposition_end_temperature = 368.8 K at 1.013 bar"
    },
    {
      "title": "Mechanism",
      "body": "Zn-OAP_links → uptake"
    },
    {
      "title": "Mechanism",
      "body": "partial_framework_destruction_during_carbonization → stability"
    },
    {
      "title": "Design Rule",
      "body": "[positive] carbonize Zn-MOF at 500 C to produce Zn-MOF-500 → Zn-MOF-500 was selected as the representative sample and showed improved practical adsorption performance over Zn-MOF"
    },
    {
      "title": "Design Rule",
      "body": "[positive] set solution pH to 3 during adsorption → pH 3 was identified as the optimal pH"
    },
    {
      "title": "Comparison",
      "body": "Zn-MOF-500 vs Zn-MOF: winner=subject_a on reusability over adsorption cycles"
    }
  ],
