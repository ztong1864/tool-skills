  "one_line_summary": "Crystalline-Zinc-Phosphite shows thermal_stability_temperature = 400.0 K for target gas",
  "key_insights": [
    {
      "title": "Measurement",
      "body": "chemical_stability_seawater_water_acid_base_and_boiling_organic_solvents = 120.0 dimensionless at 1.013 bar"
    },
    {
      "title": "Measurement",
      "body": "Hg2+_removal_capacity_aqueous_solution (Hg2+) = 277.0 mg/g at 1.013 bar"
    },
    {
      "title": "Measurement",
      "body": "Hg2+_removal_capacity_seawater (Hg2+) = 282.0 mg/g at 1.013 bar"
    },
    {
      "title": "Mechanism",
      "body": "weaker Co-N and Co-O bonding relative to Zn analogue → stability"
    },
    {
      "title": "Mechanism",
      "body": "organic_ligand_N_and_O_atoms → selectivity"
    },
    {
      "title": "Design Rule",
      "body": "[positive] incorporate HTDA triazole-diamine and BDC ligands into a metallophosphite framework → yields NTOU-4 and NTOU-4a as high-framework-stability mixed-ligand terephthalate-metallophosphite solids"
    },
    {
      "title": "Design Rule",
      "body": "[positive] use hydro(solvo)thermal heating of terephthalates, phosphite high-valence units, and soft Lewis acid-base pairs of zinc cations with nitrogen-donor triazolates → provides an alternative route to stable crystalline mixed-ligand terephthalate-metallophosphite structures without organic templates or space-filling counters"
    },
    {
      "title": "Comparison",
      "body": "NTOU-4 zinc framework vs NTOU-4a cobalt framework: winner=subject_a on framework_stability"
    }
  ],
