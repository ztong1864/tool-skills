  "one_line_summary": "SBU-2 shows Langmuir_surface_area = 496.0 m2/g for target gas",
  "key_insights": [
    {
      "title": "Measurement",
      "body": "CO2_uptake (CO2) = 33.4 wt% at 10.0 bar"
    },
    {
      "title": "Measurement",
      "body": "Langmuir_surface_area = 496.0 m2/g at 1.013 bar"
    },
    {
      "title": "Measurement",
      "body": "BET_surface_area = 339.0 m2/g at 1.013 bar"
    },
    {
      "title": "Mechanism",
      "body": "hydroxyl groups from OH-IPA ligands → uptake"
    },
    {
      "title": "Mechanism",
      "body": "Zn paddle-wheel unit formed by carboxylate coordination of IPA ligands → unknown"
    },
    {
      "title": "Design Rule",
      "body": "[positive] pre-functionalize the MAC-4 linker with a hydroxyl group using 5-hydroxyisophthalic acid to create hydroxyl-functionalized channels in the isoreticular analogue MAC-4-OH → CO2 uptake is significantly enhanced, initial uptake rate increases from 11.4 to 26.6, and zero-coverage Qst increases from 21 to about 31 kJ mol−1 despite lower surface area"
    },
    {
      "title": "Design Rule",
      "body": "[positive] combine trinuclear-triangular and paddle-wheel SBUs within one porous MOF framework → enables formation of a new porous binodal framework class, exemplified by MAC-4 as the first reported porous MOF using both SBU types together"
    },
    {
      "title": "Comparison",
      "body": "MAC-4-OH vs MAC-4: winner=subject_a on CO2_uptake"
    }
  ],
