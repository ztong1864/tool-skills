    },
    {
      "title": "Mechanism",
      "body": "release of coordinated water → stability"
    },
    {
      "title": "Mechanism",
      "body": "anion-dependent assembly → stability"
    },
    {
      "title": "Design Rule",
      "body": "[positive] use DMAC solvent during assembly of Zn-btc-dmtrz frameworks → DMAC enables assembly of compounds 1 and 2, whereas water, DMF, or DEF gave only unknown-phase powders"
    },
    {
      "title": "Design Rule",
      "body": "[positive] combine pyrazole or triazole donors with carboxylate ligands to build mixed-donor SBUs → enables construction of novel SBUs and can lead to novel porous MOFs under certain conditions"
    },
    {
      "title": "Comparison",
      "body": "MOF 2 vs HKUST-1 and H3[(Cu4Cl3)(BTTri)8]/en-H3[(Cu4Cl3)(BTTri)8]: winner=tie on CO2/N2_low_pressure_selectivity_by_slope_ratio"
    }
  ],
