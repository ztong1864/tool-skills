  "one_line_summary": "NixZn1-x(C2O4)L2 shows EPR_signal_absence_threshold = 40.0 K for target gas",
  "key_insights": [
    {
      "title": "Measurement",
      "body": "EPR_signal_absence_threshold = 40.0 K at 1.013 bar"
    },
    {
      "title": "Mechanism",
      "body": "isolated Ni(II) ions in Zn-diluted framework environment → other"
    },
    {
      "title": "Mechanism",
      "body": "easy_direction_of_magnetization → stability"
    },
    {
      "title": "Design Rule",
      "body": "[positive] keep Ni fractional percentage below 0.10 in [NixZn1-x(C2O4)(dmiz)2] mixed-metal chains → isolated Ni2+ ions become statistically prevailing at percentages lower than 0.10"
    },
    {
      "title": "Comparison",
      "body": "complexes with oxygen donors and NiO6 donor set vs complexes with nitrogen donors: winner=subject_a on zero-field splitting D value"
    },
    {
      "title": "Comparison",
      "body": "pellet sample vs loose powder sample: winner=subject_b on EPR spectrum intensity"
    },
    {
      "title": "Failure",
      "body": "[performance_regression] determine the z-direction spectral component from pellet EPR data: the z direction could not be clearly observed and gz could not be determined"
    }
  ],
