  "one_line_summary": "{[Zn4(atz)2(btc)]-4H2O}n shows breakthrough_interval_time_C3H6/C3H8 = 13.6 dimensionless for C3H6",
  "key_insights": [
    {
      "title": "Measurement",
      "body": "breakthrough_interval_time_C3H6/C3H8 (C3H6) = 1.9 dimensionless at 1.013 bar"
    },
    {
      "title": "Measurement",
      "body": "breakthrough_interval_time_C3H6/C3H8 (C3H6) = 13.6 dimensionless at 1.013 bar"
    },
    {
      "title": "Mechanism",
      "body": "elevated_temperature_operation → selectivity"
    },
    {
      "title": "Design Rule",
      "body": "[positive] incorporate multiple hydrogen-bonding interactions at the pore aperture in an ultramicroporous MOF → enables highly effective C3H6/C3H8 separation at 298-353 K with unchanged performance across the tested temperature range"
    },
    {
      "title": "Design Rule",
      "body": "[positive] design highly stable ultramicroporous MOFs for molecular-sieving separations intended for elevated-temperature operation → improves effectiveness of C3H6/C3H8 separation at temperatures closer to application conditions"
    },
    {
      "title": "Comparison",
      "body": "MOF 1 vs KAUST-7 and Co-gallate: winner=subject_a on temperature_stability_of_C3H6/C3H8_separation_performance"
    },
    {
      "title": "Comparison",
      "body": "MOF 1 vs benchmark MOF materials for C3H6/C3H8 separation: winner=subject_a on breakthrough_separation_performance"
    },
    {
      "title": "Failure",
      "body": "[performance_regression] apply previously reported molecular-sieving materials that show ultrahigh room-temperature selectivity directly in practice: practical implementation is constrained despite ultrahigh room-temperature selectivity"
    }
  ],
