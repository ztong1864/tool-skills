  "one_line_summary": "Tb3+@1 shows decomposition_temperature_onset = 200.0 K for target gas",
  "key_insights": [
    {
      "title": "Measurement",
      "body": "decomposition_temperature_onset = 200.0 K at 1.013 bar"
    },
    {
      "title": "Measurement",
      "body": "weight_loss (DMF) = 17.79 wt% at 1.013 bar"
    },
    {
      "title": "Mechanism",
      "body": "DMF decomposition generates protonated dimethylammonium counterions → stability"
    },
    {
      "title": "Mechanism",
      "body": "fully deprotonated TDA2- ligands with two coordination modes → stability"
    },
    {
      "title": "Design Rule",
      "body": "[positive] post-functionalize MOF 1 with Eu3+ ions via ion exchange → sensitivity for detecting aniline and benzaldehyde is improved, with average Ksv significantly increased"
    },
    {
      "title": "Design Rule",
      "body": "[positive] use post-functionalization via ion exchange to introduce alternative charged guest motifs into MOFs → provides an opportunity to incorporate cations, anions, organic dyes, or small coordinative molecules, endowing MOFs with functionalization"
    },
    {
      "title": "Comparison",
      "body": "MOF 1 vs free H2TDA ligand: winner=subject_a on excitation_wavelength"
    },
    {
      "title": "Comparison",
      "body": "Eu3+ post-functionalized MOF 1 vs Tb3+ post-functionalized MOF 1: winner=subject_a on effect_on_aniline_and_benzaldehyde_detection_sensitivity"
    }
  ],
