  "one_line_summary": "Design rule: use hierarchically organized pore spaces",
  "key_insights": [
    {
      "title": "Design Rule",
      "body": "[positive] use hierarchically organized pore spaces → can circumvent the inherent conflict between strong host-guest contact in micropores and reduced propagation/output"
    },
    {
      "title": "Design Rule",
      "body": "[positive] evaluate diffusivity at sufficiently low loading → self-diffusivity and transport-related parameters converge only at sufficiently small concentrations"
    },
    {
      "title": "Comparison",
      "body": "systems with increased host-lattice confinement vs systems with lower host-lattice confinement: winner=tie on guest_diffusivity"
    },
    {
      "title": "Failure",
      "body": "[performance_regression] apply the previously reported trend relating the studied variable to performance: subsequent experimental studies failed to replicate the trend"
    }
  ],
