  "one_line_summary": "Zn2(TRZ)2(Fuma) shows decomposition_onset_temperature = 300.0 K for target gas",
  "key_insights": [
    {
      "title": "Measurement",
      "body": "decomposition_onset_temperature = 300.0 K at 1.013 bar"
    },
    {
      "title": "Mechanism",
      "body": "ABAB stacking of {[Zn4(trz)4]4+}n layers directed by tar coordination mode → stability"
    },
    {
      "title": "Mechanism",
      "body": "tar ligand interconnects 2D {[Zn4(trz)4]4+}n layers into a 3D pillared framework → stability"
    },
    {
      "title": "Design Rule",
      "body": "[positive] select the aliphatic dicarboxylate ligand to control packing of {[Zn4(trz)4]4+}n layers → changes whole-framework packing and can switch between layered and 3D architectures"
    },
    {
      "title": "Design Rule",
      "body": "[positive] use flexible aliphatic carboxylate ligands together with trz as mixed ligands → frameworks are inclined to assemble into unique high-dimensional structures with multicarboxylate-bridged polynuclear cluster SBUs"
    },
    {
      "title": "Comparison",
      "body": "compound 2 vs compound 1: winner=subject_a on framework_dimensionality"
    },
    {
      "title": "Comparison",
      "body": "compound 2 vs compound 1: winner=subject_a on thermal_stability"
    },
    {
      "title": "Failure",
      "body": "[performance_regression] fix the Zn:trz:H2suc ratio at 1:1:1 and vary reaction time, temperature, and concentration: compound 1 could not be synthesized"
    }
