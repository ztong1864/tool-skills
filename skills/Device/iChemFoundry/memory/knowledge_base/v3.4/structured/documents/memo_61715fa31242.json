  "one_line_summary": "Zn(Py)(Atz) shows Langmuir_surface_area = 817.2 m2/g for target gas",
  "key_insights": [
    {
      "title": "Measurement",
      "body": "N2_uptake (N2) = 204.9 cm3/g at 1.013 bar"
    },
    {
      "title": "Measurement",
      "body": "pore_volume = 0.32 cm3/g at 1.013 bar"
    },
    {
      "title": "Measurement",
      "body": "BET_surface_area = 764.5 m2/g at 1.013 bar"
    },
    {
      "title": "Mechanism",
      "body": "acid_base_synergistic_sites → selectivity"
    },
    {
      "title": "Mechanism",
      "body": "microporous_1D_channels_with_N_rich_groups → uptake"
    },
    {
      "title": "Design Rule",
      "body": "[positive] incorporate Lewis acid-base synergistic sites together with N-rich units and abundant pores in a MOF catalyst → can significantly enhance CO2 adsorption capacity and promote the coupling reaction of CO2 and epoxides"
    },
    {
      "title": "Design Rule",
      "body": "[positive] introduce azolate-containing ligands to form strong Zn-N bonds and include acid/base functional groups as buffer guards → water stability can be obviously improved"
    },
    {
      "title": "Comparison",
      "body": "Zn(Py)(Atz) with Bu4NBr co-catalyst vs Zn(Py)(Atz) with KI co-catalyst: winner=subject_a on propylene_carbonate_yield"
    }
  ],
