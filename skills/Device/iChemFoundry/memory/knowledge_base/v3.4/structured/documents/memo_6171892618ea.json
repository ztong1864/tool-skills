    {
      "title": "Mechanism",
      "body": "medium_NDC_rotors_with_comparable_interactions_and_steric_hindrance → selectivity"
    },
    {
      "title": "Design Rule",
      "body": "[positive] introduce molecular rotors as dynamic pillar ligands into pillar-layered MOFs → enables controllable reverse and non-reverse C2H2/CO2 adsorption separation by finely tuning the ultramicropore environment"
    },
    {
      "title": "Design Rule",
      "body": "[positive] decrease pillar rotor size from ADC to smaller NDC or BDC ligands in pillar-layered Zn-TRZ MOFs → separation behavior shifts from C2H2-selective capture toward CO2-selective capture"
    },
    {
      "title": "Comparison",
      "body": "CO2 in Zn-BDC-TRZ vs C2H2 in Zn-BDC-TRZ: winner=subject_a on number_of_framework_interactions"
    }
