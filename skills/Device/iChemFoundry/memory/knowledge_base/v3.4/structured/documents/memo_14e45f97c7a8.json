  "title": "Synthesis, crystal structures and properties of th",
  "year": 2009,
  "doi": null,
  "normalized_task_id": "gas_separation",
  "target_molecules": [
    "N2",
    "H2"
  ],
  "one_line_summary": "Design rule: use a mixed-ligand synthetic approach combining tetrazolate and pyridinecarboxylate ligands",
  "key_insights": [
    {
      "title": "Mechanism",
      "body": "2-fold interpenetrated diamondoid network with free Hisonic molecules in channels formed by zigzag Zn(isonic)2 chain subunits → porosity"
    },
    {
      "title": "Mechanism",
      "body": "all carboxyl groups deprotonated → stability"
    },
    {
      "title": "Design Rule",
      "body": "[positive] use a mixed-ligand synthetic approach combining tetrazolate and pyridinecarboxylate ligands → enables access to unusual MOF structures and higher-dimensional metal-tetrazolate materials"
    },
    {
      "title": "Design Rule",
      "body": "[positive] replace a hydroxyl-group-containing ligand environment with nic ligand in the Zn square-grid framework → increases Zn-Zn square-grid distances from 3.369 and 6.105 Å to 7.837 and 6.143 Å"
    },
    {
      "title": "Comparison",
      "body": "complex 3 vs complex 2: winner=tie on 3D network type/topology"
    },
    {
      "title": "Comparison",
      "body": "complex 1 with nicotinic acid co-ligand vs complex 2 with isonicotinic acid co-ligand: winner=tie on framework dimensionality/topology"
    },
    {
      "title": "Failure",
      "body": "[performance_regression] form an interpenetrated framework to obtain porosity: interpenetration is not consistent with creating porous structures because cavities are usually occupied by self-including framework parts"
    }
  ],
