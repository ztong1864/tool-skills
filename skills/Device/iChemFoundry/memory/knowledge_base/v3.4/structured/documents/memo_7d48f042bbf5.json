  "one_line_summary": "{[Zn2(atz)2(bpydb)](DMA)8}n shows solvent_accessible_void_fraction = 63.5 dimensionless for target gas",
  "key_insights": [
    {
      "title": "Measurement",
      "body": "weight_loss = 38.1 wt% at 1.013 bar"
    },
    {
      "title": "Measurement",
      "body": "solvent_accessible_void_fraction = 63.5 dimensionless at 1.013 bar"
    },
    {
      "title": "Mechanism",
      "body": "three-dimensional porous framework with two different types of 1D helical channels along the c axis → uptake"
    },
    {
      "title": "Design Rule",
      "body": "[positive] use linker-directed vertex desymmetrization via desymmetrized ligands → obtains MOFs with different structures relative to those made from higher-symmetry ligands"
    },
    {
      "title": "Comparison",
      "body": "compound 1a vs many MOFs with open metal sites or polar donor atoms: winner=subject_b on C2H2_zero_loading_Qst"
    },
    {
      "title": "Comparison",
      "body": "compound 1a vs UTSA-50, UTSA-100a, M’MOF-3a, and UTSA-60a: winner=subject_a on C2H2_uptake_at_ambient_temperature"
    },
    {
      "title": "Failure",
      "body": "[performance_regression] use compound 1a for C2H2 selective capture instead of MOFs with abundant open metal sites and polar donor sites: C2H2 separation metrics are not comparable with some MOFs that contain abundant open metal sites and polar donor sites"
    }
  ],
