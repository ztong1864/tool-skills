  "one_line_summary": "[Zn(H2PO4)2(TzH)2] shows no_clear_weight_loss_below_temperature = 200.0 K for target gas",
  "key_insights": [
    {
      "title": "Measurement",
      "body": "overall_proton_conductivity (H+) = 0.00012 dimensionless at 1.013 bar"
    },
    {
      "title": "Measurement",
