    },
    {
      "title": "Measurement",
      "body": "structure_intact_up_to_temperature = 150.0 K at 1.013 bar"
    },
    {
      "title": "Mechanism",
      "body": "low_activation_energy → diffusion"
    },
    {
      "title": "Mechanism",
      "body": "orthophosphate_intervals_supported_by_TzH_in_2D_layers → diffusion"
    },
    {
      "title": "Design Rule",
      "body": "[positive] use TzH bridging to create 2D sheet structures with phosphate intervals of 4.6-4.8 Å → creates a promising structure that induces proton conduction"
    },
    {
      "title": "Design Rule",
      "body": "[positive] place monocoordinated phosphate groups within 0.5 nm of each other → promotes inherent proton hopping"
    },
    {
      "title": "Comparison",
      "body": "non-deuterated compound 1 vs deuterated compound 1: winner=subject_a on proton_conductivity"
    }
