    {
      "title": "Mechanism",
      "body": "slow_water_diffusion_pathway → stability"
    },
    {
      "title": "Mechanism",
      "body": "liquid_water_enables_DMF_loss → stability"
    },
    {
      "title": "Design Rule",
      "body": "[positive] sterically shield Zn2+ sites with surrounding linkers → hydrolytic stability is enhanced and water attack on Zn centers is suppressed"
    },
    {
      "title": "Design Rule",
      "body": "[positive] use slow solvent exchange between internal DMF and external water during water treatment of ZnMOF-1 or ZnMOF-2 → slow exchange promotes stepwise structural rearrangement to a water-stable Zn MOF instead of decomposition"
    },
    {
      "title": "Comparison",
      "body": "as-made ZnMOF-1 under concentrated water vapor vs as-made ZnMOF-1 immersed in liquid water: winner=subject_a on structural_stability"
    }
