  "one_line_summary": "Design rule: use an explicit atom hydrocarbon model with a flexible framework and evaluate diffusion over tempera",
  "key_insights": [
    {
      "title": "Mechanism",
      "body": "perfect_crystal_structure → diffusion"
    },
    {
      "title": "Mechanism",
      "body": "perfect_crystal_structure_with_fewer_defects → diffusion"
    },
    {
      "title": "Design Rule",
      "body": "[positive] use an explicit atom hydrocarbon model with a flexible framework and evaluate diffusion over temperature rather than only at 300 K → diffusion coefficients are reproduced within a factor of 5 of experiment across temperatures, and activation energies show close agreement with experimental values and chain-length trends"
    },
    {
      "title": "Comparison",
      "body": "fully atomistic molecular dynamics with experimental loadings vs molecular dynamics using the same model without experimental loadings: winner=subject_a on agreement_of_diffusion_coefficients_with_experiment_for_longer_alkanes"
    },
    {
      "title": "Comparison",
      "body": "simulations at experimental loadings for octane and decane vs simulations at infinite dilution for octane and decane: winner=tie on diffusion_coefficient"
    },
    {
      "title": "Failure",
      "body": "[performance_regression] use earlier molecular dynamics simulations at 300 K with simpler rigid-framework and less sophisticated hydrocarbon models: predicted diffusion coefficients were too large by 2-3 orders of magnitude and showed a periodic chain-length dependence"
    }
  ],
