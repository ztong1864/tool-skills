  "key_insights": [
    {
      "title": "Measurement",
      "body": "accessible_surface_area_volumetric = 771.0 m2/g at 1.013 bar"
    },
    {
      "title": "Measurement",
      "body": "transport_diffusivity_C2-C6_n-alkanes_at_fractional_pore_occupancy_0.5 (C2-C6 n-alkanes) = 0.5 dimensionless at 1.013 bar"
    },
    {
      "title": "Measurement",
      "body": "adsorption_properties_changed_over_time = 1.0 dimensionless at 1.013 bar"
    },
    {
      "title": "Mechanism",
      "body": "weaker_binding_of_n-pentane_due_to_tight_cage_fit → uptake"
    },
    {
      "title": "Mechanism",
      "body": "coiled_adsorbed_configurations_in_cages → diffusion"
    },
    {
      "title": "Design Rule",
      "body": "[positive] increase pore occupancy during diffusion measurements in cage-type adsorbents with narrow windows → n-hexane diffusivity at high pore occupancy becomes close to that of n-pentane"
    },
    {
      "title": "Design Rule",
      "body": "[positive] tune pore size to vary pore-guest size compatibility across an n-alkane series → can induce deviations from monotonic diffusivity decay with increasing chain length"
    },
    {
      "title": "Comparison",
      "body": "n-butane binding in ZIF-4 vs n-pentane binding in ZIF-4: winner=subject_a on binding_strength"
    }
