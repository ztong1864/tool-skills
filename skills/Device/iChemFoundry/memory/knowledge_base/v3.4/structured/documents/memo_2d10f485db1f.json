  "one_line_summary": "Design rule: design MOF pores with periodically expanded and contracted apertures decorated by electronegative gr",
  "key_insights": [
    {
      "title": "Design Rule",
      "body": "[positive] design MOF pores with periodically expanded and contracted apertures decorated by electronegative groups to exploit a synergistic equilibrium-kinetic separation mechanism → enables highly efficient selective adsorption of C2H4 with equilibrium-kinetic combined selectivity of 32.4 while maintaining modest C2H4 adsorption enthalpy"
    },
    {
      "title": "Comparison",
      "body": "ZnAtzPO4 vs (Cr)-MIL-101-SO3Ag: winner=subject_a on maximum_Qst_for_C2H4_kJ_per_mol"
    },
    {
      "title": "Comparison",
      "body": "ZnAtzPO4 vs ITQ-55: winner=subject_a on ambient_temperature_combined_selectivity"
    },
    {
      "title": "Failure",
      "body": "[performance_regression] use conventional pi-complexation-based adsorbents to strengthen C2H4 binding for C2H4/C2H6 separation: materials generally show limited stability in the presence of moisture and sulfides and require high regeneration energy"
    }
  ],
