  "one_line_summary": "Zn2(C2O4)(C2N4H3)2(H2O)0.5 shows surface_area = 782.0 m2/g for target gas",
  "key_insights": [
    {
      "title": "Measurement",
      "body": "pore_volume = 0.19 cm3/g at 1.013 bar"
    },
    {
      "title": "Measurement",
