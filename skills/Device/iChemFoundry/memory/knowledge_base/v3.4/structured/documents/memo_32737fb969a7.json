  "one_line_summary": "Design rule: select small-pore cage-type zeolites that exhibit unusual Henry constant trends and avoid less-defin",
  "key_insights": [
    {
      "title": "Mechanism",
      "body": "adsorptive cages in SSZ-39 → diffusion"
    },
    {
      "title": "Mechanism",
      "body": "chain-length-dependent diffusion in H-ZSM-5 pores → diffusion"
    },
    {
      "title": "Design Rule",
      "body": "[positive] select small-pore cage-type zeolites that exhibit unusual Henry constant trends and avoid less-defined intergrowth structures such as zeolite T or LTA when seeking observable window-effect transport behavior for n-alkanes → unusual adsorption and transport behavior becomes easier to observe"
    },
    {
      "title": "Comparison",
      "body": "Na-SSZ-39 apparent diffusion values measured with alternative carrier gas vs Na-SSZ-39 apparent diffusion values measured with helium: winner=tie on apparent_diffusion_value_reproducibility"
    },
    {
      "title": "Comparison",
      "body": "Na-SSZ-39 n-octane vs Na-SSZ-39 n-decane: winner=subject_a on apparent_diffusion_value"
    },
    {
      "title": "Failure",
      "body": "[performance_regression] use zeolite T diffusion data to establish the reported diffusion-coefficient trend: later critical re-examinations failed to corroborate the reported diffusion-coefficient trend"
    }
  ],
