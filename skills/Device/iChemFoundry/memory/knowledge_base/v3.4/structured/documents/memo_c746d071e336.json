  "one_line_summary": "Design rule: increase sorbent sample amount and corresponding bed length in the tandem column",
  "key_insights": [
    {
      "title": "Mechanism",
      "body": "force-field assignment using OPLS-AA for aromatic C/H and UFF for other atoms → other"
    },
    {
      "title": "Mechanism",
      "body": "optimized_adsorption_sites_with_close_F_H_contacts_in_HUM → selectivity"
    },
    {
      "title": "Design Rule",
      "body": "[neutral] increase sorbent sample amount and corresponding bed length in the tandem column → SIFSIX-3-Ni, Zn-atz-ipa, and TIFSIX-2-Cu-i bed lengths changed from 1.2/4.5/0.9 mm to 2/7.6/1.5 mm in the control column"
    },
    {
      "title": "Design Rule",
      "body": "[neutral] reduce packing pressure to create a loosely packed tandem column while keeping sequence and sample amount unchanged → for the loose-packed column, SIFSIX-3-Ni, Zn-atz-ipa, and TIFSIX-2-Cu-i bed lengths changed from 1.2/0.9/4.5 mm to 1.8/1.7/9 mm"
    },
    {
      "title": "Comparison",
      "body": "loosely packed tandem column with the same sequence and sample amount vs densely packed tandem column with the same sequence and sample amount: winner=tie on packing_efficiency_breakthrough_performance"
    },
    {
      "title": "Failure",
      "body": "[performance_regression] estimate low-loading Qst values for SIFSIX-3-Ni using GCMC simulations: reliable simulated Qst values at low loading could not be obtained"
    }
  ],
