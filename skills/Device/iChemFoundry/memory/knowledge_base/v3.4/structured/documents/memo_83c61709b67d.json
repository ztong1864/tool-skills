    {
      "title": "Measurement",
      "body": "solvent_accessible_void_fraction = 63.5 wt% at 1.013 bar"
    },
    {
      "title": "Measurement",
      "body": "weight_loss = 38.1 wt% at 1.013 bar"
    },
    {
      "title": "Mechanism",
      "body": "two_types_of_1D_helical_channels → uptake"
    },
    {
      "title": "Mechanism",
      "body": "ligand_LUMO_alignment_with_PA → selectivity"
    },
    {
      "title": "Design Rule",
      "body": "[positive] replace C2-symmetric Hdatz with C1-symmetric Hatz as the triazole auxiliary ligand → changes the product from a doubly interpenetrated pillar-layered MOF to a new noninterpenetrated porous framework with a helical Zn-triazolate chain building unit"
    },
    {
      "title": "Design Rule",
      "body": "[positive] use ligand symmetry modulation of a triazole linker → enables creation of unusual helical Zn-triazolate chain building units and 1D helical channels, while modulating interpenetration and pore size/curvature"
    },
    {
      "title": "Comparison",
      "body": "Zn/Hdatz-based MOF formed by replacing 4,4′-bpy with Hdatz vs 4,4′-bpy-based MOF: winner=subject_a on CO2_uptake_and_separation_ability"
    },
    {
      "title": "Comparison",
      "body": "MOF 1a vs UTSA-50, UTSA-100a, M'MOF-3a, and UTSA-60a: winner=subject_a on C2H2_uptake_at_ambient_temperature"
    }
