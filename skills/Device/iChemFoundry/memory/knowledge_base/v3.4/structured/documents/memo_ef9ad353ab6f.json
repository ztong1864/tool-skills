  "one_line_summary": "Design rule: use less-sensitive tetrazole ligands for azide-containing energetic metal-organic framework synthesi",
  "key_insights": [
    {
      "title": "Mechanism",
      "body": "azide-containing framework formed from azide-free reactants → stability"
    },
    {
      "title": "Design Rule",
      "body": "[positive] use less-sensitive tetrazole ligands for azide-containing energetic metal-organic framework synthesis → enables safer synthesis by avoiding the potential safety hazards associated with highly sensitive NaN3"
    },
    {
      "title": "Design Rule",
      "body": "[positive] use suitable porous structures and functional sites in metal-organic frameworks → improves selective adsorption and separation of gas molecules"
    },
    {
      "title": "Comparison",
      "body": "[Zn2(atz)3(N3)]n vs RDX: winner=subject_a on heat_of_detonation"
    },
    {
      "title": "Comparison",
      "body": "[Zn2(atz)3(N3)]n vs TNT: winner=subject_a on detonation_pressure"
    },
    {
      "title": "Failure",
      "body": "[performance_regression] use Pb-containing compounds including Pb-MOFs as combustion promoters in propellants: the approach is environmentally harmful"
    }
