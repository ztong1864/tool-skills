    {
      "title": "Measurement",
      "body": "heat_and_water_resistance = 1.0 dimensionless at 1.013 bar"
    },
    {
      "title": "Measurement",
      "body": "robustness = 1.0 dimensionless at 1.013 bar"
    },
    {
      "title": "Mechanism",
      "body": "CO2_partial_pressure_dependent_cage_loading → uptake"
    },
    {
      "title": "Mechanism",
      "body": "intramolecular_hydrogen_bonding_within_NH2-BDC_ligands → stability"
    },
    {
      "title": "Design Rule",
      "body": "[positive] apply supercritical CO2 activation, freeze-drying treatment, or liquid/solvent exchange during activation → stabilizes porous frameworks during activation"
    },
    {
      "title": "Design Rule",
      "body": "[positive] insert neutral pillars or introduce large cationic guests into nonrobust MOFs → sustains MOF robustness with tunable porosity"
    },
    {
      "title": "Comparison",
      "body": "triazolate C-H groups in FJU-40-NH2 under low CO2 partial pressure vs amino groups in FJU-40-NH2 under low CO2 partial pressure: winner=subject_a on predominant_CO2_binding_site"
    },
    {
      "title": "Failure",
      "body": "[performance_regression] insert neutral pillars or introduce large cationic guests into nonrobust MOFs to sustain robustness: pore volume is reduced"
    }
