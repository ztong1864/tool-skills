  "one_line_summary": "Zn2(datrz)2CO3 shows breakthrough_cycle_stability = 4.0 dimensionless for CO2/N2, CO2/CH4, C3H6/C3H8",
  "key_insights": [
    {
      "title": "Measurement",
      "body": "breakthrough_cycle_stability (CO2/N2, CO2/CH4, C3H6/C3H8) = 4.0 dimensionless at 1.013 bar"
    },
    {
      "title": "Mechanism",
      "body": "alternating_wave_shaped_layer_stacking_in_160_variant → porosity"
    },
    {
      "title": "Mechanism",
      "body": "temperature-induced ligand rotation with narrower pores → selectivity"
    },
    {
      "title": "Design Rule",
      "body": "[positive] adjust solvothermal synthesis temperature to modulate pore structures in carbonate-pillared Zn2(datrz)2CO3 → enables continuous sub-angstrom pore-size modulation and fine regulation of pore structures while preserving framework composition/building units"
    },
    {
      "title": "Design Rule",
      "body": "[positive] apply pore space partition using auxiliary ligands matched to the host pore geometry, dimensions, and binding characteristics → creates tailored pores"
    },
    {
      "title": "Comparison",
      "body": "Zn2(datrz)2CO3-180 vs Zn2(datrz)2CO3-200 and Zn2(datrz)2CO3-220: winner=tie on topology"
    },
    {
      "title": "Comparison",
      "body": "MOFs vs traditional porous solids such as zeolites and carbons: winner=subject_a on ability_to_fine_tune_pore_features"
    }
  ],
