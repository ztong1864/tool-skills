  "one_line_summary": "Design rule: use HATRZ with amino-group nitrogen participation in coordination",
  "key_insights": [
    {
      "title": "Mechanism",
      "body": "pcu-like network built from zinc(II)/ATRZ layers and inorganic sulfate pillars → stability"
    },
    {
      "title": "Mechanism",
      "body": "zinc(II)/ATRZ layers pillared by inorganic sulfate → stability"
    },
    {
      "title": "Design Rule",
      "body": "[positive] use HATRZ with amino-group nitrogen participation in coordination → can build novel chiral compounds"
    },
    {
      "title": "Design Rule",
      "body": "[positive] use aromatic polycarboxylate or polypyridine ligands to construct functionalized MOFs → these are the most commonly used ligands for functionalized MOFs"
    },
    {
      "title": "Failure",
      "body": "[performance_regression] use sulfate as a pillaring component in MOF materials: sulfate-pillared MOF materials remain extremely rarely reported"
    }
