  "one_line_summary": "Design rule: install halogen-bond donor and acceptor groups onto a single self-complementary tecton",
  "key_insights": [
    {
      "title": "Mechanism",
      "body": "solvent-filled void space in 2D BIOx connectivity → porosity"
    },
    {
      "title": "Mechanism",
      "body": "varying morphologies with varying porosity under controlled crystallization and solvent conditions → porosity"
    },
    {
      "title": "Design Rule",
      "body": "[positive] install halogen-bond donor and acceptor groups onto a single self-complementary tecton → reduces assembly variables and is presented as a promising route to stable, low-density frameworks"
    },
    {
      "title": "Design Rule",
      "body": "[positive] use organic linkers with greater covalency and extended pi-conjugation at coordination sites such as azolates or pyrazoles → overcomes the prior conductivity limitation in MOFs"
    },
    {
      "title": "Comparison",
      "body": "MOFs with more covalent, pi-conjugated linkers vs baseline MOFs: winner=subject_b on stability"
    },
    {
      "title": "Comparison",
      "body": "MOFs with more covalent, pi-conjugated linkers vs MOFs without those linker modifications: winner=subject_a on conductivity"
    },
    {
      "title": "Failure",
      "body": "[performance_regression] maintain a low-density halogen-bonded structure without sufficient thermodynamic stability: the structure collapses over time into a nonporous form"
    }
  ],
