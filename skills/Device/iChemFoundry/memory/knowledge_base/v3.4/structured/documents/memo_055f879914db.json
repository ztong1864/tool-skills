  "one_line_summary": "Zn2(H2dobdc)(datz)2-1.5DMF shows BET_surface_area = 246.0 m2/g for N2",
  "key_insights": [
    {
      "title": "Measurement",
      "body": "BET_surface_area (N2) = 246.0 m2/g at 1.013 bar"
    },
    {
      "title": "Measurement",
      "body": "recyclability_runs = 6.0 dimensionless at 15.0 bar"
    },
    {
      "title": "Measurement",
      "body": "pore_volume (N2) = 0.1 cm3/g at 1.013 bar"
    },
    {
      "title": "Mechanism",
      "body": "free hydroxyl and amino groups as HBD groups in 3D framework with 1D channels → selectivity"
    },
    {
      "title": "Mechanism",
      "body": "Zn centers and abundant HBD groups in micropores → selectivity"
    },
    {
      "title": "Design Rule",
      "body": "[positive] combine HBD groups with N-rich units in porous MOFs → promising for efficient catalytic CO2 chemical conversion"
    },
    {
      "title": "Design Rule",
      "body": "[positive] introduce N-rich units and micropores into porous MOFs → enhances CO2 affinity and thereby improves catalytic performance for CO2 cycloaddition to epoxides"
    },
    {
      "title": "Comparison",
      "body": "porous MOFs such as MOF-5, MOF-74, ZIF-68, and UiO-66 with high surface area and pore volume but lacking effective epoxide and CO2 activation sites vs MOF catalysts with active functional groups for epoxide and CO2 activation: winner=subject_b on ability_to_achieve_mild_condition_CO2_conversion"
    }
  ],
