  "key_insights": [
    {
      "title": "Mechanism",
      "body": "post-functionalization via Eu3+ and Tb3+ ion exchange with encapsulated lanthanide ions → stability"
    },
    {
      "title": "Mechanism",
      "body": "post-functionalization with Eu3+ ions → selectivity"
    },
    {
      "title": "Author Claim",
      "body": "The framework is the first reported zinc(II) MOF with lanthanide(III) post-functionalized analogues for simultaneous sensing of aniline, benzaldehyde, Cr2O7^2- and CrO4^2-."
    },
    {
      "title": "Author Claim",
      "body": "Ion-exchange post-functionalization is presented as an effective design route to introduce charged guests into MOFs and create highly efficient luminescent probes."
    }
  ],
