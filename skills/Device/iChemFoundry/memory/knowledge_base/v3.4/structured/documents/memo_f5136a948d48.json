  "key_insights": [
    {
      "title": "Measurement",
      "body": "accessible_surface_area = 1427.54 m2/g"
    },
    {
      "title": "Measurement",
      "body": "SC_to_amorphous_transformation_on_heating = 1.0 dimensionless at 1.013 bar"
    },
    {
      "title": "Mechanism",
      "body": "single-crystal-to-amorphous transformation upon heating → stability"
    },
    {
      "title": "Mechanism",
      "body": "single-crystal-to-single-crystal transformation → stability"
    },
    {
      "title": "Design Rule",
      "body": "[positive] enlarge the folding angle by replacing btc with tipa ligand → moves the chain geometry from an acute-isosceles-triangle region to an obtuse-isosceles-triangle region, placing the chain in a more relaxed state"
    },
    {
      "title": "Design Rule",
      "body": "[positive] replace a linear linker with a three-bar-slide-crank-like tritopic linker and ensure the tritopic ligand is also chosen for favorable structural transformation behavior → mechanically converts hinge motion into pore-shape change and supports structural transformation"
    },
    {
      "title": "Comparison",
      "body": "MAC-17 vs MAC-18: winner=subject_b on ease of crystallinity loss upon heating"
    },
    {
      "title": "Comparison",
      "body": "indigo blue vs sudan-I: winner=subject_a on adsorption response after TEA injection"
    }
  ],
