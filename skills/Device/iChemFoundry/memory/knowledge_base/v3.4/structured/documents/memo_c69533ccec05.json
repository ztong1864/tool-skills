  "one_line_summary": "Mn-dtzip shows C2H4_productivity = 109.6 cm3/g for C2H4",
  "key_insights": [
    {
      "title": "Measurement",
      "body": "weight_loss (DMF/H2O) = 29.8 wt% at 1.013 bar"
    },
    {
      "title": "Measurement",
      "body": "C2H4_productivity (C2H4) = 109.6 cm3/g at 1.013 bar"
    },
    {
      "title": "Measurement",
      "body": "breakthrough_recyclability_runs (C2H4/C3H6) = 4.0 dimensionless at 1.013 bar"
    },
    {
      "title": "Mechanism",
      "body": "open_metal_sites_and_accessible_uncoordinated_N/O_atoms_on_pore_walls → selectivity"
    },
    {
      "title": "Mechanism",
      "body": "3D_honeycomb_framework → stability"
    },
    {
      "title": "Design Rule",
      "body": "[positive] create open metal sites together with accessible organic hydrogen-bond-acceptor sites in the framework → improves preferential adsorption of C3H6 over C2H4 and helps overcome the capacity-selectivity trade-off"
    },
    {
      "title": "Design Rule",
      "body": "[positive] use high-porosity frameworks with polar channel surfaces decorated by rich open metal sites, uncoordinated tetrazolate N, and accessible carboxylate O sites → enables both high C3H6 uptake and significant C3H6/C2H4 selectivity, superior to spe-MOF and Ni-MOF-74"
    },
    {
      "title": "Comparison",
      "body": "srl-MOF vs spe-MOF: winner=subject_a on C3H6/C2H4 selectivity"
    }
  ],
