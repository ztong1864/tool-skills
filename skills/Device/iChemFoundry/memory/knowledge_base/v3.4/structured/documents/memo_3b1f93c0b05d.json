  "one_line_summary": "Design rule: use cooperative multiple weak interactions rather than a single strong monodentate interaction for C",
  "key_insights": [
    {
      "title": "Mechanism",
      "body": "single-crystal structure measured under fixed temperature and varied pressure (PSA conditions) → adsorption/flexibility"
    },
    {
      "title": "Design Rule",
      "body": "[positive] use cooperative multiple weak interactions rather than a single strong monodentate interaction for CO2 capture → targets the combination of strong binding affinity and high reversibility"
    },
    {
      "title": "Design Rule",
      "body": "[positive] arrange multiple uncoordinated triazolate or azolate N-donors as guest-chelating sites in a porous coordination polymer using bis-triazolate ligands with tetrahedral Zn(II) → gives very high CO2 adsorption enthalpy, strong CO2 adsorption, and high CO2/N2 selectivity"
    },
    {
      "title": "Comparison",
      "body": "framework 1 vs porous coordination polymers functionalized with uncoordinated azolate N-donors and porous coordination polymers functionalized with aromatic amino groups: winner=subject_a on CO2/N2_selectivity"
    },
    {
      "title": "Comparison",
      "body": "framework 1 vs other porous coordination polymers with similar or lower surface areas and pore volumes: winner=subject_a on CO2_uptake_at_298K_1atm"
    },
    {
      "title": "Failure",
      "body": "[performance_regression] push CO2 binding toward chemical absorption using strongly active sites: CO2 release for recycling becomes difficult"
    }
  ],
