  "one_line_summary": "{[Zn4(atz)2(btc)]-4H2O}n shows breakthrough_interval_time_C3H6/C3H8 = 13.6 dimensionless for C3H6",
  "key_insights": [
    {
      "title": "Measurement",
      "body": "breakthrough_interval_time_C3H6/C3H8 (C3H6) = 1.9 dimensionless at 1.013 bar"
    },
    {
      "title": "Measurement",
      "body": "breakthrough_interval_time_C3H6/C3H8 (C3H6) = 13.6 dimensionless at 1.013 bar"
    },
    {
      "title": "Mechanism",
      "body": "elevated_temperature → selectivity"
    },
    {
      "title": "Design Rule",
      "body": "[positive] stabilize the pore aperture with multiple hydrogen bonds → maintains essentially unchanged C3H6 adsorption and negligible C3H8 adsorption at elevated temperatures, preserving high C3H6/C3H8 separation performance across 298–353 K"
    },
    {
      "title": "Design Rule",
      "body": "[positive] design apertures narrower than the molecular dimensions of both C3H6 and C3H8 → enables molecular-sieving-based discrimination between C3H6 and C3H8"
    },
    {
      "title": "Comparison",
      "body": "material 1 vs KAUST-7 and Co-gallate: winner=subject_a on change in C3H6/C3H8 breakthrough separation performance with increasing temperature"
    },
    {
      "title": "Comparison",
      "body": "C3H6 vs C3H8: winner=subject_a on binding_energy_in_the_studied_MOF"
    },
    {
      "title": "Failure",
      "body": "[performance_regression] operate molecular-sieving MOFs at elevated temperature without preventing thermal motion and lattice expansion: molecular sieving is significantly compromised and selectivity becomes poorer at high temperature"
    }
  ],
