  "title": "Achieving Superprotonic Conduction in Metal–Organi",
  "year": 2018,
  "doi": null,
  "normalized_task_id": "gas_separation",
  "target_molecules": [
    "H2"
  ],
  "one_line_summary": "PCMOF2(Im) shows activation_energy_proton_transfer = 0.28 dimensionless for H+",
  "key_insights": [
    {
      "title": "Measurement",
      "body": "activation_energy_proton_transfer (H+) = 0.28 dimensionless at 1.013 bar"
    },
    {
      "title": "Measurement",
      "body": "proton_conductivity (H+) = 0.0013 dimensionless at 1.013 bar"
    },
    {
      "title": "Measurement",
      "body": "activation_energy = 0.21 dimensionless at 1.013 bar"
    },
    {
      "title": "Mechanism",
      "body": "abrupt humidity-dependent conductivity response → stability"
    },
    {
      "title": "Mechanism",
      "body": "humid proton-transfer network → diffusion"
    },
    {
      "title": "Design Rule",
      "body": "[positive] load β-PCMOF2 pores with less volatile, amphiprotic guest molecules → successfully enhanced anhydrous proton conductivity"
    },
    {
      "title": "Design Rule",
      "body": "[positive] combine isomorphous ligand replacement with heterocycle doping in β-PCMOF2-derived MOFs → iteratively enhances proton conductivity; PCMOF21/2(Pz) and PCMOF21/2(Tz) reach almost 2 orders of magnitude higher proton conduction than β-PCMOF2"
    },
    {
      "title": "Comparison",
      "body": "triazole-loaded systems vs pyrazole-loaded systems: winner=tie on proton_conductivity"
    }
  ],
