  ],
  "one_line_summary": "Design rule: design MOF pores simultaneously lined by methyl and amine groups",
  "key_insights": [
    {
      "title": "Mechanism",
      "body": "more_open_framework → uptake"
    },
    {
      "title": "Mechanism",
      "body": "lack_of_pendent_amino_or_methyl_groups → selectivity"
    },
    {
      "title": "Design Rule",
      "body": "[positive] design MOF pores simultaneously lined by methyl and amine groups → may yield an ultimate humid CO2 sorbent"
    },
    {
      "title": "Design Rule",
      "body": "[positive] combine two short linkers so that pore walls are lined by basic triazolate rings, polarizing acetate oxygens, and CO2-philic amine groups → designed to enhance CO2 affinity and selectivity"
    },
    {
      "title": "Comparison",
      "body": "simulated isotherm vs experimental isotherm: winner=tie on isotherm_agreement"
    },
    {
      "title": "Comparison",
      "body": "IISERP-MOF28 vs N2 adsorption benchmark at room temperature: winner=subject_b on N2_uptake"
    },
    {
      "title": "Failure",
      "body": "[performance_regression] use only neat DMF or only neat water during synthesis: framework synthesis did not work"
    }
  ],
