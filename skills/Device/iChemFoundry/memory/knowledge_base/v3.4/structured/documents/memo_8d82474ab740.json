  "one_line_summary": "CO2@ZSTU-30 shows CO2_uptake = 128.5 cm3/g for CO2",
  "key_insights": [
    {
      "title": "Measurement",
      "body": "CO2_uptake (CO2) = 128.5 cm3/g at 1.0 bar"
    },
    {
      "title": "Measurement",
      "body": "adsorption_interval (C2H4) = 5.1 dimensionless at 1.013 bar"
    },
    {
      "title": "Measurement",
      "body": "C2H4_purity (C2H4) = 98.2 dimensionless at 1.013 bar"
    },
    {
      "title": "Mechanism",
      "body": "irregular one-dimensional pores formed by mixed methyl/amino substitution → selectivity"
    },
    {
      "title": "Mechanism",
      "body": "gradient pore environment with narrow methyl-containing channel and 1D channel → selectivity"
    },
    {
      "title": "Design Rule",
      "body": "[positive] modulate the number and position of -NH2/-CH3 groups on triazole ligands in isoreticular zinc-triazole MOFs → pore chemistry is shifted from 1D channels to 2D interconnected channels and the targeted CO2 > C2H2 > C2H4 adsorption order is achieved"
    },
    {
      "title": "Design Rule",
      "body": "[positive] design adsorbents to reverse the common adsorption order so that CO2 and C2H2 are captured over C2H4 → supports the desired stepwise impurity removal for C2H4 purification"
    },
    {
      "title": "Comparison",
      "body": "ZSTU-32 vs ZSTU-31: winner=subject_a on CO2_uptake"
    }
  ],
