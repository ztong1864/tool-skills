  "one_line_summary": "[Zn3(C2O4)3(4,4'-bipy)4] shows BET_surface_area = 25.0 m2/g for target gas",
  "key_insights": [
    {
      "title": "Measurement",
      "body": "BET_surface_area = 25.0 m2/g at 1.013 bar"
    },
    {
      "title": "Measurement",
      "body": "pore_diameter = 20.0 nm at 1.013 bar"
    },
    {
      "title": "Mechanism",
      "body": "acetate removal as acetic acid → stability"
    },
    {
      "title": "Mechanism",
      "body": "2-dimensional layered structure → stability"
    },
    {
      "title": "Design Rule",
      "body": "[negative] avoid longer grinding times during mechanochemical synthesis → longer grinding decreases pore diameter and BET surface"
    },
    {
      "title": "Design Rule",
      "body": "[positive] increase temperature to favor the orthorhombic phase → higher temperature favors formation of orthorhombic structure 2"
    },
    {
      "title": "Comparison",
      "body": "product 1c vs products 1a and 1b: winner=subject_a on absorbed_pore_volume"
    },
    {
      "title": "Comparison",
      "body": "orthorhombic structure 2 vs structure 1: winner=subject_a on 4,4’-bipyridine_bridging_fraction"
    }
  ],
