  "one_line_summary": "Design rule: introduce acetate methyl groups as hydrophobic pore-lining features",
  "key_insights": [
    {
      "title": "Mechanism",
      "body": "lack_of_pendent_amino_or_methyl_groups → selectivity"
    },
    {
      "title": "Mechanism",
      "body": "binding_energy_of_lattice → stability"
    },
    {
      "title": "Design Rule",
      "body": "[positive] introduce acetate methyl groups as hydrophobic pore-lining features → improves suitability for humid CO2 capture"
    },
    {
      "title": "Design Rule",
      "body": "[positive] use monodentate pillaring acetate units combined with triazolates → can still provide more than sufficient stability for humid CO2 capture"
    },
    {
      "title": "Comparison",
      "body": "3D ZnAtzOx with bidentate oxalate vs ZnAtzOxalate with dynamic swiveling monodentate oxalate pillars: winner=subject_a on binding_energy"
    },
    {
      "title": "Comparison",
      "body": "3D layered-pillared ZnAtzOx and MAF-7 vs other compared frameworks in the binding-energy set: winner=subject_a on binding_energy"
    },
    {
      "title": "Failure",
      "body": "[performance_regression] use only neat DMF or only water as the synthesis solvent: the target framework was not obtained"
    }
  ],
