  ],
  "one_line_summary": "Design rule: change the anion from acetate to sulfate in the Zn(II)/3-amino-1,2,4-triazole solvothermal system",
  "key_insights": [
    {
      "title": "Mechanism",
      "body": "16-membered quadrangular ring windows of 3.74 x 3.79 A → porosity"
    },
    {
      "title": "Mechanism",
      "body": "amino-group coordination preserves asymmetry in framework construction → stability"
    },
    {
      "title": "Design Rule",
      "body": "[positive] change the anion from acetate to sulfate in the Zn(II)/3-amino-1,2,4-triazole solvothermal system → framework dimensionality changes from an open 2D framework to an open 3D framework with three kinds of channels"
    },
    {
      "title": "Design Rule",
      "body": "[positive] use bromide anion in the Cd(II)/3-amino-1,2,4-triazole solvothermal system → product topology changes from a 3D framework built from 2D CdSO4 sheets to a homochiral 3D framework with two types of helical channels"
    },
    {
      "title": "Comparison",
      "body": "3-amino-1,2,4-triazole in compound 4 vs 3-amino-1,2,4-triazole in the other compounds discussed in the paper: winner=tie on ligand_bridging_mode_and_charge_state"
    },
    {
      "title": "Comparison",
      "body": "left-handed helical channels in compound 3 vs right-handed helical channels in compound 3: winner=subject_b on channel_size"
    },
    {
      "title": "Failure",
      "body": "[performance_regression] solve the crystal structure of compound 3 by testing multiple orthorhombic and monoclinic space groups: all trials with candidate space groups C222, Pnma, P21/n, P21/m, P2/m, P21, Pn, P2, and Pm were unsuccessful"
    }
  ],
