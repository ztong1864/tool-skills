  "one_line_summary": "[Zn2(trz)2(bpdc)]-DMA shows solvent_loss_temperature_end = 548.0 K for CH3OH/DMA",
  "key_insights": [
    {
      "title": "Measurement",
      "body": "solvent_loss_weight_percent (CH3OH/DMA) = 20.1 wt% at 1.013 bar"
    },
    {
      "title": "Measurement",
      "body": "guest_weight_loss_DMA (DMA) = 14.7 wt% at 1.013 bar"
    },
    {
      "title": "Measurement",
      "body": "solvent_loss_temperature_onset (CH3OH/DMA) = 329.0 K at 1.013 bar"
    },
    {
      "title": "Mechanism",
      "body": "longer bpdc pillar enlarges channel size → porosity"
    },
    {
      "title": "Mechanism",
      "body": "pillared-layer structure based on Zn-triazolate layers and dicarboxylate pillars → structure"
    },
    {
      "title": "Design Rule",
      "body": "[positive] use solvent-dependent luminescent MOFs for acetone and nitrobenzene detection → solvent-dependent luminescence is useful for sensing acetone and nitrobenzene molecules"
    },
    {
      "title": "Design Rule",
      "body": "[positive] modify the pillar module in a pillared-layer MOF → channel size and shape can be controlled because pillar length is closely related to pore size"
    },
    {
      "title": "Comparison",
      "body": "MOF 1 vs MOF 2: winner=tie on topological_network"
    }
  ],
