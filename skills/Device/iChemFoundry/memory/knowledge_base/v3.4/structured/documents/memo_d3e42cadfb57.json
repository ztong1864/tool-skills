  "one_line_summary": "Design rule: operate at lower loading or model diffusion at infinite dilution to avoid intermolecular slowing",
  "key_insights": [
    {
      "title": "Mechanism",
      "body": "channel_diameter_roughly_5.5_A → diffusion"
    },
    {
      "title": "Mechanism",
      "body": "framework_symmetry_transition_monoclinic_to_orthorhombic_around_350_K → diffusion"
    },
    {
      "title": "Design Rule",
      "body": "[positive] operate at lower loading or model diffusion at infinite dilution to avoid intermolecular slowing → lower loading is associated with higher diffusivity, while higher loading lowers diffusivity"
    },
    {
      "title": "Design Rule",
      "body": "[positive] include framework flexibility for tightly fitting molecules in zeolite diffusion simulations → framework flexibility can increase diffusion coefficients with all-atom models and can alter the chain-length dependence away from the rigid-framework resonant pattern"
    },
    {
      "title": "Comparison",
      "body": "all-atom hydrocarbon model in silicalite vs united-atom hydrocarbon model in silicalite: winner=subject_b on predicted_self_diffusion_coefficient"
    },
    {
      "title": "Comparison",
      "body": "more sophisticated diffusion models vs earlier simpler diffusion models: winner=subject_a on agreement_with_experiment"
    },
    {
      "title": "Failure",
      "body": "[performance_regression] use a 2 fs timestep for all-atom hydrocarbon simulations: the simulation became unstable"
    }
  ],
