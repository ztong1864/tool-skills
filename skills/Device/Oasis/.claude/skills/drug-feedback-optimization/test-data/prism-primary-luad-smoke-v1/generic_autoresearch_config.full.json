{
  "name": "prism_primary_luad_generic_full",
  "goal": "Improve cumulative high-activity compound acquisition on fixed PRISM primary LUAD development splits.",
  "workspace": ".",
  "metric_key": "acquisition_ncg_auc_mean",
  "direction": "higher",
  "budget": 30,
  "patience": 8,
  "tolerance": 0.0,
  "timeout_seconds": 7200,
  "guard": {
    "command": ["{python}", "guard_autoresearch.py", "--strategy-path", "strategy.py"]
  },
  "baseline": {
    "command": ["{python}", "generic_evaluator.py", "baseline", "--output-dir", "{trial_dir}", "--rounds", "10", "--batch-size", "50", "--top-k", "50"]
  },
  "trial": {
    "command": ["{python}", "generic_evaluator.py", "trial", "--proposal", "{proposal_path}", "--output-dir", "{trial_dir}", "--rounds", "10", "--batch-size", "50", "--top-k", "50"]
  },
  "proposer": {
    "command": ["replace_with_your_model_adapter"]
  },
  "proposal_schema": {
    "type": "object",
    "required": ["candidate_id", "estimator", "parameters", "base_weight"],
    "properties": {
      "candidate_id": {"type": "string"},
      "estimator": {"enum": ["RandomForestRegressor", "ExtraTreesRegressor", "HistGradientBoostingRegressor"]},
      "parameters": {"type": "object"},
      "base_weight": {"type": "number", "minimum": 0.0, "maximum": 1.0},
      "calibrated_transform": {"enum": ["clip", "rank", "sigmoid"]},
      "explore_count": {"type": "integer", "minimum": 0, "maximum": 15},
      "shortlist_size": {"type": "integer", "minimum": 50, "maximum": 500},
      "similarity_threshold": {"type": "number", "minimum": 0.0, "maximum": 1.0},
      "explore_until_round": {"type": "integer", "minimum": 0, "maximum": 10}
    }
  },
  "search_guidance": [
    "Change one main model, fusion, calibration, or acquisition factor per proposal.",
    "Use recent measured failures to select the next research family.",
    "Never edit or expose frozen labels, evaluator code, split manifests, or locked-test IDs."
  ]
}
